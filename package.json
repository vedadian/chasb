{
  "name": "chasb",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A unified TypeScript backend framework with cross-runtime support, including PHP.",
  "keywords": [
    "chasb",
    "typescript",
    "backend",
    "framework",
    "php",
    "transpiler",
    "cross-runtime",
    "shared-hosting"
  ],
  "exports": {
    "./logging": {
      "types": "./dist/modules/logging.d.ts",
      "import": "./dist/modules/logging.js"
    },
    "./random": {
      "types": "./dist/modules/random.d.ts",
      "import": "./dist/modules/random.js"
    },
    "./config": {
      "types": "./dist/modules/config.d.ts",
      "import": "./dist/modules/config.js"
    },
    "./crypto": {
      "types": "./dist/modules/crypto.d.ts",
      "import": "./dist/modules/crypto.js"
    },
    "./jwt": {
      "types": "./dist/modules/jwt.d.ts",
      "import": "./dist/modules/jwt.js"
    },
    "./fs": {
      "types": "./dist/modules/fs.d.ts",
      "import": "./dist/modules/fs.js"
    },
    "./db": {
      "types": "./dist/modules/db.d.ts",
      "import": "./dist/modules/db.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/transpile/cli.ts",
    "lint": "eslint src",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "cac": "^7.1.0",
    "typescript": "^6.0.3"
  }
}
